#include <iostream>
using namespace std;
	struct vattu{
		string mavt;
		string tenvt;
		string dvt;
		long long soluongton;
		
	friend istream& operator>> (istream& in, vattu &x){
		in >> x.mavt ;
		in.ignore();
		getline(in,x.tenvt); 	
		in >> x.dvt >> x.soluongton;
		return in;
	}
	
	friend ostream& operator<< (ostream& out, vattu &x){
		out << x.mavt << " "<< x.tenvt << " " << x.dvt << " " << x.soluongton;
		return out;
	}
	
	bool search (const string ma){
		return mavt == ma; 
	}
};
	
	int main(){
		int n;
		cin >> n;
		vattu vt[n];
						// Copy
		int chon;
    do {
    	cout << endl;
        cout << "\n===== QUAN LY VAT TU =====\n";
        cout << "1. Nhap danh sach\n";
        cout << "2. Xuat danh sach\n";
        cout << "3. Tim theo MAVT\n";
        cout << "4. Sua TENVT va DVT\n";
        cout << "5. Kiem tra trung MAVT\n";
        cout << "0. Thoat\n";

        cout << "Chon: ";
        cin >> chon;
        cout << endl;
        
        switch(chon){
		case 1:
			for ( int i = 0; i < n; i++){
				cin >> vt[i]; 	
				}
				break;
				
				
		case 2:
			for ( int i = 0; i < n; i++){ 
				cout << vt[i] << " ";				
				}
					break;
					
					
		case 3:{
		string ma;	cin >> ma;
			for (int i = 0; i < n; i++){
				if(vt[i].search(ma))
				cout << vt[i] << endl;
			}
				break;}
				
	
		case 4:{
			string ma;
			cout << " Sua ten vat tu va don vi tinh vat tu";
			cin >> ma;
				for ( int i = 0; i < n; i++){
					if(vt[i].search(ma)){
					cout << " Nhap ten vat tu moi: ";
					cin >> vt[i].tenvt;
					cout << " Nhap don vi tinh moi: ";
					cin >> vt[i].dvt;
				break;
			}
		}	break;}
	
	
	case 5:{
		string ma;
		cout <<"	Kiem tra trung!" << endl << "	Hay nhap ma muon kiem tra: ";
		bool trung = 0;
		cin >> ma;
			for (int i = 0; i < n; i++){
			if(vt[i].search(ma)){
				trung = 1;
		}
	}
			if (trung){
				cout << "Ma bi trung! ";
	}
			else 
				cout << "Ma ko bi trung! ";
				break; }
				
				
	case 0: 
			cout << " Thoat!";
				break;	
				
				
	default:
			cout << "Lua chon k hop le! ";
		}
				
				
			} while(chon);
	return 0;
}
