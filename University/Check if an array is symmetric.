#include <iostream>
using namespace std;
	bool symmetric(int x, int y[]){
		
			for ( int i = 0; i < x/2; i++){
				 if ( y[i] != y[x - 1 - i]) // 0 
					return false;
					
			}
		return true;
	}
	
	
int main(){
	int n; cin >> n;
	int a[100];
		for (int i = 0; i < n; i++){
				cin >> a[i];
		}
	cout << symmetric( n, a );
	return 0;
	}
