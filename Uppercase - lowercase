#include<iostream>
using namespace std;
	char check(char a){
		if ( a >= 65 && a <= 90){
			return a+=32;
		}
		else if ( a >= 97 && a <= 122)
			return a -=32;
	}
	
	
	int main(){
		int t; cin >> t;
		char c;
		for ( int i = 0; i < t; i++){
			cin >> c ;
			cout << check(c) << endl;
		}	
	return 0;
	}
