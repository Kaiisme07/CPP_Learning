/*  Bài 3. Nhập vào n số nguyên không âm, đếm và liệt kê các số thuận nghịch trong
dãy số vừa nhập, liệt kê theo thứ tự xuất hiện trong mảng.
Input:
Dòng đầu tiên là n (1<=n<=100000) - số lượng số trong dãy
Dòng thứ hai là n số trong dãy
Output:
Dòng đầu tiên là số lượng số thuận nghịch trong dãy
Dòng thứ 2 liệt kê các số thuận nghịch trong dãy   */



#include <iostream>
using namespace std;
	bool palindromic(int x){

		int org = x;
		int res = 0;
			while (x){
				res = res*10 + x%10;
				x /= 10;
			}
			return (res == org);
	}
	
	void list(int n, int a[]){
		int cnt = 0;
		for (int i = 0; i < n; i++){
    		if (palindromic(a[i])){
    			cnt++;}
    		}
    		cout << cnt << endl;
    			
    		for (int i = 0; i < n; i++){
    		if (palindromic(a[i])){
    			cout << a[i] << " ";}
			
		}
	}
	
	
    int main(){
        int n; cin >> n;
        int a[n];
            for ( int i = 0; i < n; i++){
               cin >> a[i];}
    	list(n, a);
        return 0;
    }
    
